{
  "name": "AgriLink Report Validation System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "report-validation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an AI content moderator for AgriLink, an agricultural social platform. Your job is to analyze user reports and determine if they are VALID or INVALID.\n\nAnalyze the following factors:\n1. Report Type: {{ $json.reportType }}\n2. Post Content: {{ $json.postContent }}\n3. Reporter's Description: {{ $json.description }}\n4. Context: Agricultural/farming community platform\n\nValidation Criteria:\n- SPAM: Repetitive, promotional, or irrelevant content\n- FRAUD: Fake products, scams, misleading business practices\n- MISINFORMATION: False agricultural advice, fake scientific claims\n- INAPPROPRIATE: Offensive language, adult content, harassment\n- HARASSMENT: Personal attacks, bullying, threats\n- VIOLENCE: Threats of violence, dangerous content\n- COPYRIGHT: Stolen images, plagiarized content\n\nRespond with ONLY a JSON object in this exact format:\n{\n  \"decision\": \"VALID\" or \"INVALID\",\n  \"confidence\": 0.0-1.0,\n  \"reasoning\": \"Brief explanation of your decision\",\n  \"severity\": \"LOW\", \"MEDIUM\", or \"HIGH\",\n  \"recommendedAction\": \"WARN\", \"REMOVE\", \"RESTRICT\", or \"NONE\"\n}"
            },
            {
              "role": "user",
              "content": "Please analyze this report:\n\nReport Type: {{ $json.reportType }}\nPost Content: \"{{ $json.postContent }}\"\nReporter Description: \"{{ $json.description }}\"\nPost Author: {{ $json.postAuthor }}\nReporter: {{ $json.reporterName }}"
            }
          ]
        },
        "options": {
          "temperature": 0.3,
          "maxTokens": 500
        }
      },
      "id": "gpt4o-analysis",
      "name": "GPT-4o Analysis",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "openAiApi": "openai-credentials"
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse GPT-4o response and extract decision data\nconst gptResponse = $input.first().json.message.content;\n\ntry {\n  // Extract JSON from GPT response\n  const jsonMatch = gptResponse.match(/\\{[\\s\\S]*\\}/);\n  if (!jsonMatch) {\n    throw new Error('No JSON found in GPT response');\n  }\n  \n  const aiDecision = JSON.parse(jsonMatch[0]);\n  \n  // Validate required fields\n  if (!aiDecision.decision || !['VALID', 'INVALID'].includes(aiDecision.decision)) {\n    throw new Error('Invalid decision format');\n  }\n  \n  // Get original report data\n  const reportData = $('Webhook Trigger').first().json;\n  \n  return {\n    reportId: reportData.reportId,\n    reporterId: reportData.reporterId,\n    reportedUserId: reportData.reportedUserId,\n    postId: reportData.postId,\n    reportType: reportData.reportType,\n    aiDecision: aiDecision.decision,\n    confidence: aiDecision.confidence || 0.5,\n    reasoning: aiDecision.reasoning || 'No reasoning provided',\n    severity: aiDecision.severity || 'MEDIUM',\n    recommendedAction: aiDecision.recommendedAction || 'NONE',\n    processedAt: new Date().toISOString(),\n    originalReport: reportData\n  };\n} catch (error) {\n  // Fallback for parsing errors\n  const reportData = $('Webhook Trigger').first().json;\n  return {\n    reportId: reportData.reportId,\n    reporterId: reportData.reporterId,\n    reportedUserId: reportData.reportedUserId,\n    postId: reportData.postId,\n    reportType: reportData.reportType,\n    aiDecision: 'INVALID',\n    confidence: 0.1,\n    reasoning: 'AI analysis failed - defaulting to invalid',\n    severity: 'LOW',\n    recommendedAction: 'NONE',\n    processedAt: new Date().toISOString(),\n    error: error.message,\n    originalReport: reportData\n  };\n}"
      },
      "id": "process-decision",
      "name": "Process AI Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-valid",
              "leftValue": "={{ $json.aiDecision }}",
              "rightValue": "VALID",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
